@startuml
title Sistema de gestion hospitalaria - Diagrama UML completo
left to right direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false

class Usuario {
  - id: int
  - nombre: str
  - apellido: str
  - dni: str
  - usuario: str
  - password: str
  - rol: str
  - activo: bool
  + aDiccionario(): dict
  + estaActivo(): bool
}

class UsuarioMedico {
  - especialidad: str
  + aDiccionario(): dict
  + atenderTurno(): void
  + consultarHistoria(): void
}

class UsuarioSecretaria {
  + registrarPaciente(): void
  + registrarTurno(): void
  + cancelarTurno(): void
  + reprogramarTurno(): void
}

class Paciente {
  - id: int
  - nombre: str
  - apellido: str
  - dni: str
  - telefono: str
  - direccion: str
  - fechaNacimiento: str
  - activo: bool
  + aDiccionario(): dict
  + estaActivo(): bool
}

class Agenda {
  - id: int
  - idMedico: int
  - dias: list
  + agregarBloque(): void
  + eliminarBloque(): void
  + consultarDisponibilidad(): list
}

class BloqueHorario {
  - dia: str
  - horaInicio: str
  - horaFin: str
  + perteneceAlMedico(): bool
  + estaDisponible(): bool
}

class Turno {
  - id: int
  - fecha: str
  - hora: str
  - motivoConsulta: str
  - estado: str
  - historialReprogramaciones: list
  + cancelar(): void
  + reprogramar(): void
  + marcarAusente(): void
  + marcarAtendido(): void
  + vincularAtencion(): void
}

class AtencionClinica {
  - datos: dict
  - observaciones: str
  - diagnostico: str
  - indicaciones: str
  + agregarAdenda(): void
  + aDiccionario(): dict
  + getId(): int
  + getIdPaciente(): int
  + getIdMedico(): int
}

class Adenda {
  - fecha: str
  - idMedico: int
  - texto: str
  + aDiccionario(): dict
}

class FabricaAtencion <<Factory Method>> {
  + crear(id, turno, idMedico, observaciones, diagnostico, indicaciones, momento): AtencionClinica
}

class RepositorioJson <<Singleton>> {
  - instancia: RepositorioJson
  + cargar(ruta: str): list
  + guardar(ruta: str, datos: list): void
  + getInstancia(): RepositorioJson
}

Usuario <|-- UsuarioMedico
Usuario <|-- UsuarioSecretaria

UsuarioMedico "1" -- "1" Agenda : administra >
Agenda "1" *-- "1..*" BloqueHorario : contiene

Paciente "1" -- "0..*" Turno : solicita >
UsuarioMedico "1" -- "0..*" Turno : atiende >
Agenda "1" -- "0..*" Turno : dispone horario >
Turno "0..1" -- "0..1" AtencionClinica : genera >

AtencionClinica "1" *-- "0..*" Adenda : registra >
Paciente "1" -- "0..*" AtencionClinica : tiene historia >
UsuarioMedico "1" -- "0..*" AtencionClinica : registra >

FabricaAtencion ..> AtencionClinica : crea
FabricaAtencion ..> Turno : recibe datos de
RepositorioJson ..> Usuario : persiste
RepositorioJson ..> Paciente : persiste
RepositorioJson ..> Agenda : persiste
RepositorioJson ..> Turno : persiste
RepositorioJson ..> AtencionClinica : persiste

note right of UsuarioMedico
  UsuarioMedico hereda de Usuario
  porque comparte identificacion,
  credenciales, rol activo y datos
  personales. Agrega especialidad.
end note

note right of Agenda
  La composicion indica que los
  BloqueHorario pertenecen a una
  Agenda y no tienen vida propia
  fuera de ella.
end note

note bottom of Turno
  Turno relaciona al Paciente y al
  UsuarioMedico. Tambien puede
  consultar una Agenda para reservar
  un bloque disponible.
end note

note bottom of AtencionClinica
  Una AtencionClinica pertenece a un
  Paciente y fue creada por un medico.
  Sus Adendas son parte de la atencion
  y no sustituyen la nota original.
end note

note bottom of FabricaAtencion
  Patron Factory Method:
  centraliza la validacion y construccion
  de AtencionClinica desde un Turno.
end note

note bottom of RepositorioJson
  Patron Singleton:
  garantiza una instancia compartida
  para cargar y guardar los archivos JSON.
end note

@enduml
